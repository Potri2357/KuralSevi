{
  "name": "kural-sevi",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Driven Voice Assistant for Livelihood Mapping and NSQF-Aligned Skilling Recommendations for SC Communities under PM-AJAY GIA",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=apps/web\" \"npm run dev --workspace=apps/voice-api\"",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=packages/recommendation-engine && npm run build --workspace=apps/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:start": "npx supabase start",
    "db:migrate": "npx supabase db push",
    "db:seed": "npx supabase db reset",
    "aggregate": "tsx --env-file=.env scripts/aggregate-planning.ts",
    "ingest:eshram": "tsx --env-file=.env scripts/ingest-eshram.ts",
    "ingest:udyam": "tsx --env-file=.env scripts/ingest-udyam.ts",
    "generate:embeddings": "tsx --env-file=.env scripts/generate-embeddings.ts",
    "scrape:nsdc": "tsx --env-file=.env scripts/scrape-nsdc.ts",
    "test:pipeline": "tsx --env-file=.env scripts/test-full-flow.ts",
    "typecheck": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "@types/node": "^22.15.3",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "8.5.26",
    "next": {
      "postcss": "8.5.26"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
