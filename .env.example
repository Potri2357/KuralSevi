# =============================================================================
# KURAL SEVI — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# --- Supabase (Database & Storage) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# --- Google AI (Gemini 2.5 for LLM reasoning + embeddings) ---
GOOGLE_AI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- Sarvam AI (STT + TTS for Indian regional languages) ---
SARVAM_API_KEY=your-sarvam-api-key
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech

# --- Twilio (IVR telephony) ---
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+91XXXXXXXXXX

# --- WhatsApp Business API ---
WHATSAPP_API_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-verify-token

# --- Application Settings ---
APP_URL=http://localhost:3000
VOICE_API_URL=http://localhost:8000
OFFICER_SLA_DAYS=3
PILOT_LANGUAGES=ta,hi,te
BATCH_AGGREGATION_SCHEDULE=0 2 * * *

# --- Data Ingestion (Track 1) ---
DATA_GOV_API_KEY=your-data-gov-api-key
ESHRAM_DATASET_ID=your-eshram-dataset-id
UDYAM_DATASET_ID=your-udyam-dataset-id

# --- Security ---
CONSENT_HMAC_SECRET=your-hmac-secret-for-aadhaar-hashing
ENCRYPTION_KEY=your-32-byte-encryption-key

# --- Feature Flags ---
ENABLE_MOCK_STT=false
ENABLE_MOCK_TTS=false
ENABLE_MOCK_LLM=false
